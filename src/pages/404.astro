---
import SiteLayout from '../layouts/SiteLayout.astro';
import { profile, emailHref } from '../data/profile';
---
<SiteLayout title={`Page not found · ${profile.name}`} description="This page could not be found. Return to Amogh Skanda Suresh's portfolio or contact him directly.">
  <main id="main" class="not-found page-width">
    <a class="wordmark" href="/"><span class="mark" aria-hidden="true">as<span>↗</span></span><span>{profile.name}</span></a>
    <p class="eyebrow">404 / Page not found</p><h1>Let's get you<br />back to the work<span>.</span></h1>
    <p>The page you're looking for isn't here.</p>
    <div class="hero-actions"><a class="button primary" href="/">Return to the portfolio <span aria-hidden="true">↗</span></a><a class="text-link" href={emailHref}>Email Amogh <span aria-hidden="true">↗</span></a></div>
  </main>
</SiteLayout>
<style>
  .not-found { min-height: 100vh; padding-block: 45px 90px; }
  .not-found > .eyebrow { margin-top: clamp(90px, 18vh, 190px); color: var(--muted); }
  h1 { font-size: clamp(42px, 6vw, 84px); font-weight: 500; margin-top: 22px; }
  h1 span { color: var(--accent); }
  .not-found > p:not(.eyebrow) { color: var(--muted); margin-top: 24px; font-size: 14px; }
</style>
