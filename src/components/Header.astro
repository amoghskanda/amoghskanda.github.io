---
import { profile } from '../data/profile';
---
<header class="site-header">
  <a class="wordmark" href="#main" aria-label={`${profile.name}, home`}>
    <span class="mark" aria-hidden="true">as<span>↗</span></span><span>{profile.name}</span>
  </a>
  <nav aria-label="Main navigation"><a href="#about">About</a><a href="#work">Work</a><a href="#lab">Lab</a><a href="#contact">Contact <span aria-hidden="true">↗</span></a></nav>
  <button class="command-trigger" type="button" data-open-command aria-label="Search site navigation" aria-keyshortcuts="Meta+K Control+K"><span aria-hidden="true">⌕</span><kbd>⌘ K</kbd></button>
</header>
