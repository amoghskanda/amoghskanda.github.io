---
import { internshipTopics, internshipPeriod } from '../data/internships';
const topic = internshipTopics.scene;
---
<section class="internship-section page-width" id="internships" aria-labelledby="internship-heading">
      <div class="section-heading"><div><p class="eyebrow">02 / Bosch · Machine Learning Engineer Intern</p><h2 id="internship-heading">Scene synthesis.<br>Data tooling<span>.</span></h2></div><div class="placement-dates"><span>{internshipPeriod}</span></div></div>
      <p class="work-overview">Work on synthetic data, 3D geometry, dataset inspection, and ML operations. Explore the workflows and the engineering behind them.</p>
      <div class="internship-workbench" data-internship-workbench>
        <div class="internship-tabs" role="tablist" aria-label="Internship projects"><button id="intern-scene-tab" type="button" role="tab" aria-selected="true" aria-controls="internship-project" data-internship-topic="scene">01 / Neural rendering</button><button id="intern-data-tab" type="button" role="tab" aria-selected="false" aria-controls="internship-project" tabindex="-1" data-internship-topic="data">02 / Dataset tooling</button></div>
        <div id="internship-project" role="tabpanel" aria-labelledby="intern-scene-tab" tabindex="0">
          <div class="internship-content"><div class="internship-story"><p class="eyebrow" data-internship-category>{topic.category}</p><h3 data-internship-title>{topic.title}</h3><p data-internship-summary>{topic.summary}</p><div class="internship-contribution"><h4>My contribution</h4><p data-internship-contribution>{topic.contribution}</p></div><div class="tag-row" data-internship-tags>{topic.tags.map(tag => <span>{tag}</span>)}</div><p class="internship-side-note" data-internship-side-note>{topic.note}</p></div>
          <div class="internship-media"><figure data-internship-scene><div class="media-kicker"><span>Research reference</span><span>Actor relocation</span></div><img src="/assets/neurad-actor-shift-reference.png" width="1576" height="354" loading="lazy" alt="Published NeuRAD example: a white van in the original nuScenes street view and the same actor shifted into the road."><figcaption><a href="https://research.zenseact.com/publications/neurad/">NeuRAD · Tonderski et al. · CVPR 2024 · Figure 1 detail ↗</a><span>Published method illustration. This is not my internship output.</span></figcaption></figure>
          <figure data-internship-fiftyone hidden><div class="media-kicker"><span>Tool reference</span><span>FiftyOne by Voxel51</span></div><div class="tool-demo" data-tool-demo><div class="tool-demo-placeholder"><div class="tool-preview-symbol" aria-hidden="true"><span></span><span></span><span></span></div><h4>Inspect samples.<br>Understand the labels.</h4><p>See the official FiftyOne dataset visualizer in action.</p><button type="button" class="tool-play" data-tool-play><span aria-hidden="true">▶</span> Play public tool demo</button></div><img data-tool-image data-src="/assets/fiftyone-official-projections.gif" hidden alt="Official Voxel51 FiftyOne demonstration of a point-cloud projection grid and class-label filters."><button type="button" class="tool-stop" data-tool-stop hidden>Stop demo <span aria-hidden="true">Ⅱ</span></button></div><figcaption><a href="https://docs.voxel51.com/user_guide/app.html#using-the-3d-visualizer">Official Voxel51 documentation example ↗</a><span>Public tool demo, not a capture of my workplace data.</span><a class="media-license" href="/assets/fiftyone-LICENSE.txt">FiftyOne source license ↗</a></figcaption></figure></div></div>
          <div class="internship-workflow"><div class="internship-workflow-heading"><p class="eyebrow">Conceptual workflow / select a stage</p><button type="button" class="icon-button" data-internship-next aria-label="Next internship workflow stage">→</button></div><div class="internship-stages" role="group" aria-label="Internship workflow stages" data-internship-stages style={`--stage-count: ${topic.stages.length}`}>
            {topic.stages.map(([title, subtitle], index) => <button type="button" data-internship-stage={index} aria-pressed={index === 0 ? 'true' : 'false'}><span>{String(index + 1).padStart(2, '0')}</span><strong>{title}</strong><small>{subtitle}</small><span class="stage-connection" aria-hidden="true">→</span></button>)}
          </div><div class="internship-stage-detail" aria-live="polite" aria-atomic="true"><span data-internship-stage-label>01 / {topic.stages[0][0]}</span><p data-internship-stage-copy>{topic.stages[0][2]}</p></div></div>
        </div>
      </div>
      <noscript><div class="internship-static"><h3>{internshipTopics.data.title}</h3><p>{internshipTopics.data.summary}</p><p>{internshipTopics.data.contribution}</p><a class="text-link" href="https://docs.voxel51.com/user_guide/app.html#using-the-3d-visualizer">FiftyOne documentation ↗</a></div></noscript>
</section>

<script>
  import { initInternship } from "../scripts/internship";
  const root = document.querySelector<HTMLElement>("[data-internship-workbench]");
  if (root) initInternship(root);
</script>
