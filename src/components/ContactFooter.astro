---
import { profile, emailHref } from '../data/profile';
---
<footer class="contact-section" id="contact"><div class="page-width">
  <p class="eyebrow">07 / Let's talk</p>
  <div class="contact-heading"><h2>Have something<br />worth building?</h2><a href={emailHref} class="contact-arrow" aria-label="Email Amogh" title="Email Amogh">↗</a></div>
  <a class="contact-email" href={emailHref}>{profile.email}</a>
  <div class="contact-links"><a href={profile.linkedin}>LinkedIn ↗</a><a href={profile.github}>GitHub ↗</a><a href={`tel:${profile.phone}`}>{profile.phoneDisplay} ↗</a><span>{profile.location} · Summer 2027</span></div>
  <div class="footer-bottom"><span>{profile.name}</span><a href="#main">Back to top ↑</a><span>ML · Multimodal AI · Agentic pipelines · Software engineering</span></div>
</div></footer>
