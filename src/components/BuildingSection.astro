---
import { trackerProject, visualOdometryProject } from '../data/content';
---
<section class="building-section page-width" id="building">
  <div class="section-heading"><div><p class="eyebrow">03 / Building now</p><h2>Currently working on<span>.</span></h2></div><span class="status-label"><span aria-hidden="true"></span>In progress</span></div>
  <div class="building-projects">
    <article class="tracker-feature" id="visual-odometry" aria-labelledby="visual-odometry-title">
      <div>
        <h3 id="visual-odometry-title">{visualOdometryProject.title}</h3>
        <p>{visualOdometryProject.summary}</p>
        <p>{visualOdometryProject.implementation}</p>
        <div class="tag-row">{visualOdometryProject.tags.map(tag => <span>{tag}</span>)}</div>
        <p class="small-note">{visualOdometryProject.status}</p>
        <a href={visualOdometryProject.url} class="text-link">{visualOdometryProject.linkLabel}<span aria-hidden="true">↗</span></a>
      </div>
      <div class="tracker-pipeline" aria-label="Visual odometry workflow">{visualOdometryProject.stages.map(([title, detail], index) => <Fragment>{index > 0 && <span class="flow-connector" aria-hidden="true">↓</span>}<div><span>{String(index + 1).padStart(2, '0')}</span><strong>{title}</strong><small>{detail}</small></div></Fragment>)}</div>
    </article>
    <article class="tracker-feature" id="internship-tracker" aria-labelledby="internship-tracker-title">
      <div><h3 id="internship-tracker-title">{trackerProject.title[0]}<br />{trackerProject.title[1]}</h3><p>{trackerProject.summary}</p><p>{trackerProject.implementation}</p><div class="tag-row">{trackerProject.tags.map(tag => <span>{tag}</span>)}</div><p class="small-note">{trackerProject.status}</p></div>
      <div class="tracker-pipeline" aria-label="Internship tracker workflow">{trackerProject.stages.map(([title, detail], index) => <Fragment>{index > 0 && <span class="flow-connector" aria-hidden="true">↓</span>}<div><span>{String(index + 1).padStart(2, '0')}</span><strong>{title}</strong><small>{detail}</small></div></Fragment>)}</div>
    </article>
  </div>
</section>
