---
import { profile, resumeRequestHref } from '../data/profile';
import { projects, initialProject, workflowChoices } from '../data/projects';
import { diagramMarkup } from '../lib/workflow-diagram';
const project = projects[initialProject];
---
<section data-workbench aria-label="Explore engineering workflows">
  <div class="workbench-hero page-width">
    <div class="hero-copy">
      <p class="availability"><span aria-hidden="true"></span>{profile.availability}</p>
      <p class="eyebrow hero-eyebrow">{profile.role}</p>
      <h1>{profile.firstName}<br />{profile.otherNames}<span class="name-period">.</span></h1>
      <p class="hero-statement">{profile.heroStatement[0]}<br />{' '}{profile.heroStatement[1]}</p>
      <p class="hero-description">{profile.introduction}</p>
      <p class="hero-toolkit" aria-label="AI toolkit">{profile.toolkit.map(item => <span>{item}</span>)}</p>
      <div class="hero-actions"><a class="button primary magnetic" href="#work">Explore the work <span aria-hidden="true">↓</span></a><a class="text-link" href={resumeRequestHref}>Request resume <span aria-hidden="true">↗</span></a></div>
      <div class="hero-footnote"><span>{profile.location}</span><span>{profile.graduation}</span></div>
    </div>
    <div class="system-panel" data-project-preview>
      <div class="panel-top"><span><span class="tiny-square" aria-hidden="true"></span>SYSTEM VIEW / <span data-project-number>{project.number}</span></span><span data-project-kind>{project.kind}</span></div>
      <div class="panel-heading"><div><p class="eyebrow">Explore the engineering</p><h2 data-project-title>{project.title}</h2></div><span class="view-symbol" aria-hidden="true">⌘</span></div>
      <div class="workflow-options" data-workflow-options role="group" aria-label="Perception examples" hidden><button type="button" data-perception-flow="image" aria-pressed="true">2D workflow</button><button type="button" data-perception-flow="spatial" aria-pressed="false">3D workflow</button></div>
      <div class="pipeline-visual" data-pipeline aria-label={`${project.title}: conceptual workflow`} set:html={diagramMarkup(project, 0)} />
      <div class="pipeline-controls"><span class="diagram-caption">Conceptual workflow</span><div><button class="icon-button" type="button" data-replay aria-label="Replay workflow" title="Replay workflow">↻</button><button class="icon-button" type="button" data-step aria-label="Next workflow stage" title="Next workflow stage">→</button></div></div>
      <p class="workflow-context" data-workflow-context>{project.contextNote}</p>
      <div class="inspector">
        <div class="inspector-tabs" role="tablist" aria-label="Project information">
          <button id="project-overview" type="button" role="tab" aria-controls="project-inspector" aria-selected="true" data-inspect="overview">Overview</button>
          <button id="project-decisions" type="button" role="tab" aria-controls="project-inspector" aria-selected="false" tabindex="-1" data-inspect="decisions">Decisions</button>
          <button id="project-evidence" type="button" role="tab" aria-controls="project-inspector" aria-selected="false" tabindex="-1" data-inspect="evidence">Evidence <span aria-hidden="true">↗</span></button>
        </div>
        <div class="inspector-body" id="project-inspector" role="tabpanel" aria-labelledby="project-overview" tabindex="0" data-inspector><span class="inspector-label">The work</span><p>{project.overview}</p></div>
      </div>
    </div>
  </div>
  <div class="workflow-rail-heading page-width"><span class="eyebrow">Explore five workflows</span><span>Select a project to inspect its pipeline <span aria-hidden="true">↓</span></span></div>
  <div class="project-rail page-width" id="workflows" role="group" aria-label="Choose one of five workflows">
    {workflowChoices.map(choice => <button type="button" class:list={{ active: choice.key === initialProject }} aria-pressed={choice.key === initialProject ? 'true' : 'false'} data-project={choice.key}>
      <span>{projects[choice.key].number} / {choice.category}</span><strong>{choice.title.map((line, index) => <Fragment>{index > 0 && <br />}{line}</Fragment>)}</strong><span class="rail-arrow" aria-hidden="true">↗</span>
    </button>)}
  </div>
</section>
<script>
  import { initWorkbench } from '../scripts/workbench';
  const root = document.querySelector<HTMLElement>('[data-workbench]');
  if (root) initWorkbench(root);
</script>
